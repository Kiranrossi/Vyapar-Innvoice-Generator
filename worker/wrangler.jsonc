{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agam-billing",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // The React app (client/dist) is served as static files; only /api/* runs the Worker.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agam-billing",
      "database_id": "6d9e378c-12f4-417e-948d-79dc1325e87b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
